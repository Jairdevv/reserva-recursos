{
   "ts-node": {
    "files": true
  },
  "compilerOptions":{
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["esnext"],
    "target": "ESnext",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "strict": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["node", "express"],
  },
  "include": ["src/**/*"],
}